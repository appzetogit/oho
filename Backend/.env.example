# Copy to Backend/.env and fill in. Only MONGODB_URI and JWT_SECRET are required
# to boot — everything else has a default or degrades gracefully.

NODE_ENV=development
# The frontend defaults its API base to http://localhost:5000/api/v1, so keep
# this at 5000 unless you also set VITE_API_BASE_URL for the frontend.
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=zicab_taxi

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5180,http://localhost:5190
FRONTEND_URL=http://localhost:5190
APP_NAME=ZI CAB

# Optional for a single process: without it rate limiting falls back to
# in-memory. REQUIRED once more than one instance runs, because socket.io needs
# the Redis adapter to broadcast across them — see ecosystem.config.cjs.
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379

# ── OTP ──────────────────────────────────────────────────────────────────────
# Without SMS_INDIA_HUB_* credentials no OTP can actually be delivered, so one
# of these is needed to log in at all in development.
#
# STATIC_OTP_PHONE + STATIC_OTP_CODE accept a fixed code for ONE number, which
# is what you usually want.
#
# USE_DEFAULT_OTP=true accepts STATIC_OTP_CODE for EVERY number, across user
# login, driver login, driver onboarding and pooling onboarding. That is a full
# authentication bypass — never leave it on anywhere real accounts exist.
# USE_DEFAULT_OTP=false
# STATIC_OTP_PHONE=
# STATIC_OTP_CODE=
# OTP_EXPIRY_MINUTES=10

# SMS delivery (SMS India Hub). OTP send fails without these.
# SMS_INDIA_HUB_USERNAME=
# SMS_INDIA_HUB_PASSWORD=
# SMS_INDIA_HUB_API_KEY=
# SMS_INDIA_HUB_SENDER_ID=
# SMS_INDIA_HUB_DLT_TEMPLATE_ID=

# ── Firebase / push ──────────────────────────────────────────────────────────
# Prefer FIREBASE_SERVICE_ACCOUNT_PATH: it keeps the private key in one
# chmod-600 file instead of inlining it into this env. Never commit either.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
# FIREBASE_DATABASE_URL=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional integrations — features that use them stay off until configured.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=
